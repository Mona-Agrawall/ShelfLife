# Copy this to terraform.tfvars and fill in your values
# DO NOT commit terraform.tfvars to git

region        = "us-east-1"
instance_type = "t3.small" # Use t2.micro for personal free tier
project_name  = "shelflife"

# Restrict this to your IP for security: curl ifconfig.me
allowed_cidr = "0.0.0.0/0"

# AWS Academy only: set to "LabInstanceProfile"
# Personal account: leave as ""
instance_profile_name = ""
